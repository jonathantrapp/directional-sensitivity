# Random temporary folder avoids deleting or overwriting any pre-existing export.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
execute_process(COMMAND "${TEST}" "${BINARY}/capture-tests-${suffix}"
  OUTPUT_VARIABLE output ERROR_VARIABLE error RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Capture tests failed: ${output}\n${error}")
endif()
message(STATUS "${output}")
set(source "${BINARY}/capture-tests-${suffix}")
file(SHA256 "${source}/packets.csv" before)
execute_process(COMMAND "${REVIEW}" "${source}-comparison" "${source}-comparison-review" RESULT_VARIABLE result)
if(NOT result EQUAL 2 OR EXISTS "${source}-comparison-review")
  message(FATAL_ERROR "Comparison recording accepted as identity calibration")
endif()
execute_process(COMMAND "${REVIEW}" "${source}" "${source}-review" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Offline session review failed")
endif()
file(READ "${source}-review/review.json" manifest)
file(STRINGS "${source}-review/timing.csv" timing_rows)
list(LENGTH timing_rows timing_count)
if(NOT timing_count EQUAL 97)
  message(FATAL_ERROR "Timing diagnostics did not retain every scheduled trial")
endif()
if(NOT manifest MATCHES "\"eligible\":48")
  message(FATAL_ERROR "Known identity traces lost during review")
endif()
file(STRINGS "${source}-review/phases.csv" phase_rows)
list(LENGTH phase_rows phase_count)
file(STRINGS "${source}-review/packet-phases.csv" packet_rows)
list(LENGTH packet_rows packet_count)
if(NOT phase_count EQUAL 97 OR NOT packet_count EQUAL 193)
  message(FATAL_ERROR "Phase review did not retain every synthetic trial/packet")
endif()
file(READ "${source}-review/index.html" page)
if(NOT page MATCHES "Main start offset" OR NOT page MATCHES "NW")
  message(FATAL_ERROR "Review page lacks offsets or correct directions")
endif()
execute_process(COMMAND "${REVIEW}" "${source}" "${source}-review" RESULT_VARIABLE result)
if(NOT result EQUAL 2)
  message(FATAL_ERROR "Review overwrote an existing directory")
endif()
file(SHA256 "${source}/packets.csv" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Review changed source packets")
endif()
file(APPEND "${source}/packets.csv" "trial_1,999999,0,0,0,0,0\n")
execute_process(COMMAND "${REVIEW}" "${source}" "${source}-invalid-review" RESULT_VARIABLE result)
if(NOT result EQUAL 2 OR EXISTS "${source}-invalid-review")
  message(FATAL_ERROR "Malformed packet order was accepted/exported")
endif()
